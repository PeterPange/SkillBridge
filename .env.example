# ============================================================
# SkillBridge 环境变量示例
#
# 使用:cp .env.example .env
# docker compose 与 Python 端(skillbridge/config.py)共用同一份 .env。
# 未创建 .env 时,两者均使用与下方一致的默认值。
# ============================================================

# ---------- Neo4j(知识图谱) ----------
# Python 驱动连接地址;端口需与 NEO4J_BOLT_PORT 保持一致
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skillbridge
# 数据库名(社区版固定为 neo4j)
NEO4J_DATABASE=neo4j
# 宿主机端口映射(docker-compose.yml 使用)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- PostgreSQL + pgvector(结构化数据 / 向量检索) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge
POSTGRES_DB=skillbridge

# ---------- LLM(阶段 1B / 阶段 4 使用,骨架阶段不需要) ----------
# 留空时,LLM 语义校验等能力自动跳过,不影响其余功能
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ---------- 应用 ----------
LOG_LEVEL=INFO
