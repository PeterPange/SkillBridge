# ============================================================
# SkillBridge 环境变量示例
#
# 使用:cp .env.example .env
# docker compose 与 Python 端(skillbridge/config.py)共用同一份 .env。
# 未创建 .env 时,两者均使用与下方一致的默认值。
# ============================================================

# ---------- Neo4j(知识图谱) ----------
# Python 驱动连接地址;端口需与 NEO4J_BOLT_PORT 保持一致
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skillbridge
# 数据库名(社区版固定为 neo4j)
NEO4J_DATABASE=neo4j
# 宿主机端口映射(docker-compose.yml 使用)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---------- PostgreSQL + pgvector(结构化数据 / 向量检索) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=skillbridge
POSTGRES_DB=skillbridge

# ---------- LLM(阶段 1B / 阶段 4 使用,骨架阶段不需要) ----------
# 留空时,LLM 语义校验等能力自动跳过,不影响其余功能
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ---------- 技能归一化(阶段 1B,可选) ----------
# Embedding 后端:auto = 优先 sentence-transformers 本地模型(默认),
#           lexical = 强制离线词面匹配(CI / 无网络环境)
# SKILL_NORMALIZATION_BACKEND=auto
# 本地多语言 Embedding 模型(首次使用时自动下载缓存)
# SKILL_NORMALIZATION_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# huggingface.co 不可达时可用镜像下载模型(huggingface_hub 原生支持):
# HF_ENDPOINT=https://hf-mirror.com
# 模型已缓存时可离线加载,加快启动:
# HF_HUB_OFFLINE=1

# ---------- O*NET Web Services(阶段 1A 数据采集,可选) ----------
# 官方 API 需在 https://www.onetcenter.org/ 注册后获取凭据
# 未配置时自动使用内置 fixture(基于公开 O*NET OnLine 数据整理),不影响流程
# ONET_API_USERNAME=
# ONET_API_PASSWORD=

# ---------- 应用 ----------
LOG_LEVEL=INFO
